{
  "importMap": "import_map.json",
  "tasks": {
    "build": "deno check -c deno.json && deno run -A https://github.com/silverbulletmd/silverbullet/releases/download/edge/plug-compile.js --info --importmap import_map.json nldates.plug.yaml",
    "build-dbg": "deno check -c deno.json && deno run -A https://github.com/silverbulletmd/silverbullet/releases/download/edge/plug-compile.js --debug --info --importmap import_map.json nldates.plug.yaml"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "exclude": [
      "*.md",
      ".*.md",
      "**/*.md",
      "*.plug.js",
      "**/*.plug.js"
    ]
  }
}
